<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <!-- EDIT THESE INDEPENDENTLY: changing buttons does not recolor backgrounds. -->
    <color name="app_button_color">#B5DCF0</color>
    <color name="app_background_gradient_color">#4168c4</color>
    <color name="app_text_accent_color">#000000</color>

    <!-- LAYA icon/button blue = #0093D0; blue text = #0077A8.
         The gradient above is a soft tint of the same blue. -->
    <color name="app_icon_color">#000000</color>
    <color name="app_button_text_color">@color/black</color>
    <color name="app_background_gradient_start_color">@color/white</color>
    <color name="app_surface_color">#8ca2c2</color>
    <color name="app_section_color">#435a7a</color>
    <color name="app_outline">#B5DCF0</color>
    <color name="app_ink">#2F3E46</color>
    <color name="app_secondary_ink">@color/app_text_accent_color</color>

    <!-- Switch ON/OFF and slider filled/unfilled colors; independent of other UI colors. -->
    <color name="app_control_active">#294C7A</color>
    <color name="app_control_inactive">#708198</color>
    <color name="app_control_disabled_active">#526780</color>
    <color name="app_control_disabled_inactive">#8793A3</color>
    <color name="app_control_thumb">@color/white</color>
    <color name="app_control_disabled_thumb">#D4DBE5</color>
</resources>
