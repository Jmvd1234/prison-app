<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/prisonTransferContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/prisonTransferLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="8dp"
            android:labelFor="@id/inputPrisonTransferDate"
            android:text="@string/prison_transfer_label"
            android:textColor="@color/laya_label"
            android:textSize="16sp" />
        <com.example.myapplication.InfoTooltip
            android:id="@+id/prisonTransferHelp" style="@style/InfoTooltipButton"
            app:helpTitle="@string/tooltip_transfer_title"
            app:helpText="@string/tooltip_transfer"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/inputPrisonTransferDate"
            android:layout_width="120dp"
            android:layout_height="32dp"
            android:layout_marginVertical="5dp"
            android:background="@drawable/entertextbox"
            android:paddingStart="7dp"
            android:paddingEnd="4dp"
            android:paddingVertical="4dp"
            android:hint="mm/dd/yy"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true"
            android:textColor="@color/laya_input_text"
            android:textColorHint="@color/laya_muted"
            android:textSize="11sp"
            app:backgroundTint="@null" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/clearPrisonTransferDate"
        style="@style/AppTextButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="end"
        android:text="@string/prison_transfer_clear"
        android:contentDescription="@string/prison_transfer_clear_description" />
</LinearLayout>
