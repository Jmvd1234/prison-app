<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clemencyBanner" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="12dp" android:padding="12dp" android:gravity="top" android:orientation="horizontal"
    android:background="@drawable/clemency_warning_box" android:visibility="gone">
    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="10dp"
        android:src="@drawable/ic_clemency_warning" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/clemency_banner_title"
            android:textSize="15sp" android:textStyle="bold" android:textColor="@color/laya_danger"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="@string/clemency_banner_body" android:textSize="14sp" android:textColor="@color/laya_danger"/>
    </LinearLayout>
</LinearLayout>