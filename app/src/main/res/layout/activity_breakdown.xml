<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/laya_background"
    android:orientation="vertical"
    tools:context=".BreakdownActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp">
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/breakdownBackButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/breakdown_back"
            android:padding="12dp"
            app:srcCompat="@drawable/outline_arrow_back_24"
            app:tint="@color/laya_primary"
            android:elevation="0dp"
            android:stateListAnimator="@null"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/breakdown_screen_title"
            android:textColor="@color/laya_text"
            android:textSize="26sp"
            android:textStyle="bold"/>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">
            <TextView
                android:id="@+id/breakdownProfileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/laya_text"
                android:textSize="24sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Alex Rivera"
                tools:visibility="visible"/>
            <include layout="@layout/view_clemency_banner"/>
            <LinearLayout
                android:id="@+id/breakdownPreviewControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="13dp"
                android:layout_marginHorizontal="-16dp"
                android:background="@drawable/laya_card"
                android:paddingLeft="26dp"
                android:paddingRight="26dp"
                android:paddingTop="23dp"
                android:paddingBottom="29dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView android:id="@+id/serviceLimitMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/service_limit_reached" android:textColor="@color/laya_danger" android:textSize="14sp" android:visibility="gone"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/overview_detail" android:textColor="@color/laya_text" android:textStyle="bold" android:textSize="20sp"/>
                <LinearLayout
                    android:id="@+id/breakdownObservationRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/laya_summary_box"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:paddingVertical="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:labelFor="@id/breakdownObservationDate"
                        android:text="@string/breakdown_observation_label"
                        android:textColor="@color/laya_label" android:textSize="16sp"/>
                    <TextView android:id="@+id/breakdownObservationDate"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:minHeight="32dp" android:gravity="center_vertical"
                        android:textSize="16sp" android:textStyle="bold"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true"
                        android:textColor="@color/laya_label" tools:text="Oct 25, 2026 · Today"/>
                    <com.example.myapplication.InfoTooltip android:id="@+id/observationDateHelp"
                        style="@style/InfoTooltipButton" android:layout_width="28dp" android:layout_height="28dp"
                        app:helpTitle="@string/tooltip_observation_title"
                        app:helpText="@string/tooltip_observation"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <com.google.android.material.button.MaterialButton android:id="@+id/timelineZoomOut" style="@style/BreakdownDateStepButton" android:text="−" android:contentDescription="@string/timeline_zoom_out"/>
                    <TextView android:id="@+id/timelineZoomLevel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/laya_label"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/timelineZoomIn" style="@style/BreakdownDateStepButton" android:text="+" android:contentDescription="@string/timeline_zoom_in"/>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/timeline_zoom_hint" android:textColor="@color/laya_label" android:textSize="12sp"/>
                <com.example.myapplication.ZoomTimelineScrollView android:id="@+id/timelineZoomScroll" android:layout_width="match_parent" android:layout_height="wrap_content">
                <com.example.myapplication.TimelineMilestonesLayout
                    android:id="@+id/breakdownTimeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.slider.Slider
                        android:id="@+id/breakdownDateSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/breakdown_slider_description"
                        android:valueFrom="0"
                        android:valueTo="1"
                        app:thumbColor="@color/app_slider_active"
                        app:trackColorActive="@color/app_slider_active"
                        app:trackColorInactive="@color/app_slider_inactive"
                        app:tickVisible="false"/>
                </com.example.myapplication.TimelineMilestonesLayout>
                </com.example.myapplication.ZoomTimelineScrollView>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="6dp"
                        android:text="@string/breakdown_zero_marker_hint"
                        android:textColor="@color/laya_text"
                        android:textSize="12sp"/>
                    <com.example.myapplication.InfoTooltip
                        android:id="@+id/releaseMarkersHelp" style="@style/InfoTooltipButton"
                        app:helpTitle="@string/tooltip_markers_title"
                        app:helpText="@string/tooltip_markers"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/breakdownRangeStart"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/laya_label"
                        android:textSize="12sp"
                        tools:text="Start: Jun 20, 2018"/>
                    <TextView
                        android:id="@+id/breakdownRangeEnd"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/laya_label"
                        android:textSize="12sp"
                        tools:text="End: Oct 5, 2026"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/serviceChargesSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="0dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">
                    <TextView android:id="@+id/serviceChargesHeading" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/service_charges" android:textColor="@color/laya_label" android:textSize="12sp"/>
                    <LinearLayout android:id="@+id/serviceChargeGrid" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <com.google.android.material.button.MaterialButton android:id="@+id/serviceAddCharge"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content"
                            android:layout_height="48dp" android:text="@string/service_add" android:textAllCaps="false"/>
                    </LinearLayout>
            </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/breakdownReleaseDates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="0dp"
                android:background="@drawable/breakdown_table_background"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone"
                tools:visibility="visible">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/laya_warning_box"
                        android:padding="10dp"
                        android:layout_marginEnd="4dp">
                        <TextView
                            style="@style/BreakdownBalanceLabel"
                            android:drawableStart="@drawable/release_minimum_dot"
                            android:drawablePadding="6dp"
                            android:id="@+id/serviceMinimumHeading"
                            android:labelFor="@id/breakdownMinimumReleaseDate"
                            android:text="@string/breakdown_minimum_release"
                            android:textSize="13sp"
                            android:textColor="@color/laya_warning_text"/>
                        <TextView
                            android:id="@+id/breakdownMinimumReleaseDate"
                            style="@style/BreakdownBalanceValue"
                            tools:text="Jun 20, 2027"
                            android:textColor="@color/laya_warning_text"/>
                        <TextView
                            android:id="@+id/breakdownMinimumReleaseState"
                            style="@style/BreakdownBalanceLabel"
                            android:textSize="12sp"
                            tools:text="@string/breakdown_release_estimate"
                            android:textColor="@color/laya_warning_text"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/laya_warning_box"
                        android:padding="10dp"
                        android:layout_marginStart="4dp">
                        <TextView
                            style="@style/BreakdownBalanceLabel"
                            android:drawableStart="@drawable/release_maximum_dot"
                            android:drawablePadding="6dp"
                            android:id="@+id/serviceMaximumHeading"
                            android:labelFor="@id/breakdownMaximumReleaseDate"
                            android:text="@string/breakdown_maximum_release"
                            android:textSize="13sp"
                            android:textColor="@color/laya_warning_text"/>
                        <TextView
                            android:id="@+id/breakdownMaximumReleaseDate"
                            style="@style/BreakdownBalanceValue"
                            tools:text="Jun 20, 2030"
                            android:textColor="@color/laya_warning_text"/>
                        <TextView
                            android:id="@+id/breakdownMaximumReleaseState"
                            style="@style/BreakdownBalanceLabel"
                            android:textSize="12sp"
                            tools:text="@string/breakdown_release_estimate"
                            android:textColor="@color/laya_warning_text"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    style="@style/BreakdownBalanceLabel"
                    android:layout_marginTop="10dp"
                    android:text="@string/breakdown_release_basis"
                    android:textSize="12sp"/>
            </LinearLayout>
            <TextView
                android:id="@+id/breakdownStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="24dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/breakdown_loading"
                android:textColor="@color/laya_text"
                android:textSize="16sp"
                tools:visibility="gone"/>
            <FrameLayout
                android:id="@+id/breakdownCard"
                android:layout_marginTop="19dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible"
                android:background="@drawable/laya_card"
                android:paddingLeft="26dp"
                android:paddingTop="23dp"
                android:paddingRight="26dp"
                android:paddingBottom="29dp"
                android:layout_marginHorizontal="-16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="0dp"
                        android:text="@string/profile_breakdown_title"
                        android:textColor="@color/laya_text"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                    <!-- Shared with the popup; every table value remains a separate TextView. -->
                    <include layout="@layout/view_sentence_breakdown"/>
                </LinearLayout>
            </FrameLayout>
            <!-- Card shadow insets supply the same 32dp visible gap as the cards above. -->
            <include layout="@layout/view_deduction_dates" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="0dp" android:layout_marginHorizontal="-16dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
