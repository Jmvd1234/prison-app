<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/laya_background"
    android:orientation="vertical"
    tools:context=".BreakdownActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp">
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/breakdownBackButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/breakdown_back"
            android:padding="12dp"
            app:srcCompat="@drawable/outline_arrow_back_24"
            app:tint="@color/laya_primary"
            android:elevation="0dp"
            android:stateListAnimator="@null"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/breakdown_screen_title"
            android:textColor="@color/laya_text"
            android:textSize="26sp"
            android:textStyle="bold"/>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">
            <TextView
                android:id="@+id/breakdownProfileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/laya_text"
                android:textSize="24sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Alex Rivera"
                tools:visibility="visible"/>
            <LinearLayout
                android:id="@+id/breakdownObservationRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/laya_summary_box"
                android:padding="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                tools:visibility="visible">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/BreakdownBalanceLabel"
                        android:labelFor="@id/breakdownObservationDate"
                        android:text="@string/breakdown_observation_label"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/breakdownObservationDate"
                        style="@style/BreakdownBalanceValue"
                        android:minHeight="48dp"
                        android:layout_marginTop="0dp"
                        android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:textColor="@color/laya_label"
                        tools:text="Oct 14, 2026 · Today"/>
                </LinearLayout>
                <com.example.myapplication.InfoTooltip
                    android:id="@+id/observationDateHelp"
                    style="@style/InfoTooltipButton"
                    app:helpTitle="@string/tooltip_observation_title"
                    app:helpText="@string/tooltip_observation"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/breakdownPreviewControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">
                <LinearLayout
                    android:id="@+id/breakdownDateSteps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        style="@style/BreakdownDateStepGroup">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/breakdownDayBack"
                            style="@style/BreakdownDateStepButton"
                            android:contentDescription="@string/breakdown_previous_day"
                            android:text="@string/breakdown_step_minus"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/BreakdownDateStepLabel"
                            android:text="@string/breakdown_step_day"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/breakdownDayForward"
                            style="@style/BreakdownDateStepButton"
                            android:contentDescription="@string/breakdown_next_day"
                            android:text="@string/breakdown_step_plus"/>
                    </LinearLayout>
                    <LinearLayout
                        style="@style/BreakdownDateStepGroup"
                        android:layout_marginHorizontal="6dp">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/breakdownMonthBack"
                            style="@style/BreakdownDateStepButton"
                            android:contentDescription="@string/breakdown_previous_month"
                            android:text="@string/breakdown_step_minus"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/BreakdownDateStepLabel"
                            android:text="@string/breakdown_step_month"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/breakdownMonthForward"
                            style="@style/BreakdownDateStepButton"
                            android:contentDescription="@string/breakdown_next_month"
                            android:text="@string/breakdown_step_plus"/>
                    </LinearLayout>
                    <LinearLayout
                        style="@style/BreakdownDateStepGroup">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/breakdownYearBack"
                            style="@style/BreakdownDateStepButton"
                            android:contentDescription="@string/breakdown_previous_year"
                            android:text="@string/breakdown_step_minus"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/BreakdownDateStepLabel"
                            android:text="@string/breakdown_step_year"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/breakdownYearForward"
                            style="@style/BreakdownDateStepButton"
                            android:contentDescription="@string/breakdown_next_year"
                            android:text="@string/breakdown_step_plus"/>
                    </LinearLayout>
                </LinearLayout>
                <com.example.myapplication.TimelineMilestonesLayout
                    android:id="@+id/breakdownTimeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.slider.Slider
                        android:id="@+id/breakdownDateSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/breakdown_slider_description"
                        android:valueFrom="0"
                        android:valueTo="1"
                        app:thumbColor="@color/app_slider_active"
                        app:trackColorActive="@color/app_slider_active"
                        app:trackColorInactive="@color/app_slider_inactive"
                        app:tickVisible="false"/>
                </com.example.myapplication.TimelineMilestonesLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="6dp"
                        android:text="@string/breakdown_zero_marker_hint"
                        android:textColor="@color/laya_text"
                        android:textSize="12sp"/>
                    <com.example.myapplication.InfoTooltip
                        android:id="@+id/releaseMarkersHelp" style="@style/InfoTooltipButton"
                        app:helpTitle="@string/tooltip_markers_title"
                        app:helpText="@string/tooltip_markers"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/breakdownRangeStart"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/laya_label"
                        android:textSize="12sp"
                        tools:text="Start: Jun 20, 2018"/>
                    <TextView
                        android:id="@+id/breakdownRangeEnd"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/laya_label"
                        android:textSize="12sp"
                        tools:text="End: Oct 5, 2026"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/breakdownReleaseDates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:background="@drawable/breakdown_table_background"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone"
                tools:visibility="visible">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/laya_warning_box"
                        android:padding="10dp"
                        android:layout_marginEnd="4dp">
                        <TextView
                            style="@style/BreakdownBalanceLabel"
                            android:drawableStart="@drawable/release_minimum_dot"
                            android:drawablePadding="6dp"
                            android:labelFor="@id/breakdownMinimumReleaseDate"
                            android:text="@string/breakdown_minimum_release"
                            android:textSize="13sp"
                            android:textColor="@color/laya_warning_text"/>
                        <TextView
                            android:id="@+id/breakdownMinimumReleaseDate"
                            style="@style/BreakdownBalanceValue"
                            tools:text="Jun 20, 2027"
                            android:textColor="@color/laya_warning_text"/>
                        <TextView
                            android:id="@+id/breakdownMinimumReleaseState"
                            style="@style/BreakdownBalanceLabel"
                            android:textSize="12sp"
                            tools:text="@string/breakdown_release_estimate"
                            android:textColor="@color/laya_warning_text"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/laya_warning_box"
                        android:padding="10dp"
                        android:layout_marginStart="4dp">
                        <TextView
                            style="@style/BreakdownBalanceLabel"
                            android:drawableStart="@drawable/release_maximum_dot"
                            android:drawablePadding="6dp"
                            android:labelFor="@id/breakdownMaximumReleaseDate"
                            android:text="@string/breakdown_maximum_release"
                            android:textSize="13sp"
                            android:textColor="@color/laya_warning_text"/>
                        <TextView
                            android:id="@+id/breakdownMaximumReleaseDate"
                            style="@style/BreakdownBalanceValue"
                            tools:text="Jun 20, 2030"
                            android:textColor="@color/laya_warning_text"/>
                        <TextView
                            android:id="@+id/breakdownMaximumReleaseState"
                            style="@style/BreakdownBalanceLabel"
                            android:textSize="12sp"
                            tools:text="@string/breakdown_release_estimate"
                            android:textColor="@color/laya_warning_text"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    style="@style/BreakdownBalanceLabel"
                    android:layout_marginTop="10dp"
                    android:text="@string/breakdown_release_basis"
                    android:textSize="12sp"/>
            </LinearLayout>
            <TextView
                android:id="@+id/breakdownStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="24dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/breakdown_loading"
                android:textColor="@color/laya_text"
                android:textSize="16sp"
                tools:visibility="gone"/>
            <FrameLayout
                android:id="@+id/breakdownCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible"
                android:background="@drawable/laya_card"
                android:paddingLeft="26dp"
                android:paddingTop="23dp"
                android:paddingRight="26dp"
                android:paddingBottom="29dp"
                android:layout_marginHorizontal="-16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/profile_breakdown_title"
                        android:textColor="@color/laya_text"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                    <!-- Shared with the popup; every table value remains a separate TextView. -->
                    <include layout="@layout/view_sentence_breakdown"/>
                </LinearLayout>
            </FrameLayout>
            <include layout="@layout/view_deduction_dates"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
