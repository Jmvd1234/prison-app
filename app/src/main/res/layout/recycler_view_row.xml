<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="0dp"

        android:layout_marginHorizontal="15dp"
        android:layout_marginVertical="10dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:cardCornerRadius="20dp"
        android:background="@drawable/login_title"
        app:cardBackgroundColor="#efc065">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.cardview.widget.CardView
                android:id="@+id/imageCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:cardCornerRadius="20dp"
                android:layout_marginTop="15dp"
                android:layout_marginHorizontal="10dp">

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="125dp"
                    android:layout_height="125dp"
                    android:clickable="true"
                    android:focusable="true"
                    tools:srcCompat="@tools:sample/avatars" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/imageCard"
                app:layout_constraintTop_toTopOf="parent"
                android:orientation="vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp">

                <TextView
                    android:id="@+id/firstNameBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="First Name: John"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                     />
                <TextView
                    android:id="@+id/lastNameBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last Name: Doe"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    />
                <TextView
                    android:id="@+id/chargeBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Charge: Jaywalking"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    />
                <TextView
                    android:id="@+id/arrestDateBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Arrest Date: 01/24/1980"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    />
                <TextView
                    android:id="@+id/timeLeftBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time Left: N/A"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    />
                <TextView
                    android:id="@+id/timeOverdueBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time Overdue: 6y 5m 1d"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    />
                <TextView
                    android:id="@+id/actionBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Action: Contact Authorities"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    />

                <TextView
                    android:id="@+id/exportPDFBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Export PDF"
                    android:textColor="@color/black"
                    android:textStyle="bold|italic"
                    android:layout_gravity="center"
                    android:paddingTop="10dp"
                    />

            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>