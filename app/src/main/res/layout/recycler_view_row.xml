<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="0dp"
        android:layout_marginVertical="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/laya_card"
        android:paddingLeft="16dp"
        android:paddingTop="13dp"
        android:paddingRight="16dp"
        android:paddingBottom="19dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@+id/imageCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginHorizontal="10dp"
                app:cardCornerRadius="14dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/laya_surface">
                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="125dp"
                    android:layout_height="125dp"
                    android:scaleType="centerCrop"
                    android:clickable="false"
                    android:focusable="false"
                    tools:srcCompat="@tools:sample/avatars"/>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:id="@+id/profileDetails"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                app:layout_constraintStart_toEndOf="@id/imageCard"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:baselineAligned="false">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/firstNameBox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="First Name: John"
                            android:textColor="@color/laya_text"
                            android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/lastNameBox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Last Name: Doe"
                            android:textColor="@color/laya_text"
                            android:textStyle="bold"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/deleteProfileEntryButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="12dp"
                        android:contentDescription="@string/delete_entry"
                        app:srcCompat="@drawable/ic_deduction_trash"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/leaArrestDateBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LEA Arrest Date: Jan 24, 1980"
                    android:textColor="@color/laya_text"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/commitmentDateBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jail Commitment Date: \nJan 26, 1980"
                    android:textColor="@color/laya_text"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/minTimeBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Minimum Time Remaining: \nN/A"
                    android:textColor="@color/laya_primary"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/maxTimeBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Maximum Time Remaining: \nN/A"
                    android:textColor="@color/laya_primary"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/actionBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Action: Stand By"
                    android:textColor="@color/laya_text"
                    android:textStyle="bold"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/profileDetailsBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="imageCard,profileDetails"/>
            <LinearLayout
                android:id="@+id/profileActions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/profileDetailsBottom"
                app:layout_constraintBottom_toBottomOf="parent">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editEntryButton"
                    style="@style/AppFilledButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="@string/edit_entry"
                    android:textAllCaps="false"
                    android:textColor="@color/laya_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/laya_white"
                    app:strokeColor="@color/laya_primary"
                    app:strokeWidth="1dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/expandBreakdownBox"
                    style="@style/AppFilledButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="@string/view_breakdown"
                    android:textAllCaps="false"
                    android:textColor="@color/laya_white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/laya_primary"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
