<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/deductionDatesPanel" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="12dp" android:layout_marginHorizontal="-16dp" android:orientation="vertical"
    android:background="@drawable/laya_card" android:paddingLeft="26dp" android:paddingRight="26dp" android:paddingTop="23dp" android:paddingBottom="29dp" android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/laya_section_icon" android:padding="8dp" android:importantForAccessibility="no" app:srcCompat="@drawable/ic_deduction_adjust"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/deduction_title" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/laya_text"/>
            <TextView style="@style/DeductionLabel" android:layout_marginTop="3dp" android:text="@string/deduction_subtitle"/>
        </LinearLayout>
        <com.example.myapplication.InfoTooltip
            android:id="@+id/monthlyDeductionHelp" style="@style/InfoTooltipButton"
            app:helpTitle="@string/tooltip_deductions_title"
            app:helpText="@string/tooltip_deductions"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp">
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/deductionSearch"
                style="@style/DeductionField"
                android:minWidth="0dp"
                android:paddingEnd="48dp"
                android:hint="@string/deduction_search_compact"
                android:contentDescription="@string/deduction_search"
                android:inputType="text"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:saveEnabled="false"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/deductionClearSearch"
                style="@style/AppTextButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_gravity="end|center_vertical"
                android:text="×"
                android:textSize="24sp"
                android:contentDescription="@string/deduction_clear_search"
                android:visibility="gone"/>
        </FrameLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/deductionAddMonth"
            style="@style/DeductionOutlineButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/deduction_add"
            app:icon="@drawable/ic_deduction_add"
            app:iconSize="16dp"
            app:iconPadding="6dp"/>
    </LinearLayout>
    <TextView android:id="@+id/deductionEligibility" style="@style/DeductionLabel" android:layout_marginBottom="8dp" android:visibility="gone"/>
    <LinearLayout android:id="@+id/deductionMonthsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    <TextView android:id="@+id/deductionEmpty" style="@style/DeductionLabel" android:gravity="center" android:paddingVertical="28dp" android:text="@string/deduction_none" android:textColor="@color/laya_muted"/>
    <LinearLayout android:id="@+id/deductionPagination" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:visibility="gone">
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/laya_border"/>
        <TextView android:id="@+id/deductionShowing" style="@style/DeductionLabel" android:gravity="center" android:layout_marginTop="12dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/deductionPrevious" style="@style/DeductionOutlineButton" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp" android:text="‹" android:textSize="24sp" android:contentDescription="@string/deduction_previous"/>
            <TextView android:id="@+id/deductionPage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:textColor="@color/laya_text" android:textSize="14sp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/deductionNext" style="@style/DeductionOutlineButton" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp" android:text="›" android:textSize="24sp" android:contentDescription="@string/deduction_next"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="14dp" android:background="@drawable/laya_summary_box" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView style="@style/DeductionLabel" android:layout_width="0dp" android:layout_weight="1" android:gravity="end" android:text="@string/deduction_selected"/>
            <TextView android:id="@+id/deductionSelectedDays" style="@style/DeductionValue" android:layout_width="wrap_content" android:layout_marginHorizontal="6dp" android:textSize="20sp"/>
            <TextView android:id="@+id/deductionSelectedCount" style="@style/DeductionLabel" android:layout_width="wrap_content" android:textSize="11sp"/>
        </LinearLayout>
        <TextView android:id="@+id/deductionAppliedDays" style="@style/DeductionLabel" android:gravity="center" android:layout_marginTop="6dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/deductionRecalculate" style="@style/AppFilledButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="10dp" android:paddingHorizontal="10dp" android:text="@string/deduction_recalculate" android:textSize="13sp" android:textAllCaps="false" app:icon="@drawable/ic_deduction_recalculate" app:iconSize="16dp" app:iconGravity="textStart"/>
        <TextView android:id="@+id/deductionSaveStatus" style="@style/DeductionLabel" android:gravity="center" android:accessibilityLiveRegion="polite" android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
