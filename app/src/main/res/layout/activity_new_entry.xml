<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".newEntryActivity"
    android:background="@color/laya_background">
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginBottom="10dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:layout_marginTop="20dp"
            android:layout_marginStart="20dp"
            android:textStyle="bold"
            android:textColor="@color/laya_text"
            android:background="@drawable/login_title"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <ImageButton
            android:id="@+id/homeButtonNE"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:background="@null"
            android:onClick="goHomeNE"
            android:src="@drawable/outline_bungalow_24"
            app:tint="@color/laya_primary"
            android:elevation="0dp"
            android:stateListAnimator="@null"/>
    </LinearLayout>
    <ScrollView
        android:id="@+id/newEntryScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="parent"
            android:layout_marginHorizontal="0dp"
            android:paddingBottom="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/laya_text"
                android:textStyle="bold"
                android:text="ADD ENTRY"
                android:textSize="35sp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/laya_card"
                android:paddingLeft="26dp"
                android:paddingTop="23dp"
                android:paddingRight="26dp"
                android:paddingBottom="29dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <include layout="@layout/view_profile_photo"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="start"
                        android:paddingStart="15dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="First Name"
                            android:textColor="@color/laya_label"
                            android:textSize="20sp"/>
                        <EditText
                            android:id="@+id/inputFirstName"
                            android:layout_width="120dp"
                            android:layout_height="32dp"
                            android:background="@drawable/entertextbox"
                            android:layout_marginVertical="5dp"
                            android:paddingStart="7dp"
                            android:textSize="11sp"
                            android:hint="e.g. John"
                            android:textColor="@color/laya_input_text"
                            android:textColorHint="@color/laya_muted"
                            app:backgroundTint="@null"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:paddingEnd="4dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Last Name"
                            android:textColor="@color/laya_label"
                            android:textSize="20sp"/>
                        <EditText
                            android:id="@+id/inputLastName"
                            android:layout_width="120dp"
                            android:layout_height="32dp"
                            android:background="@drawable/entertextbox"
                            android:layout_marginVertical="5dp"
                            android:paddingStart="7dp"
                            android:textSize="11sp"
                            android:hint="e.g. Doe"
                            android:textColor="@color/laya_input_text"
                            android:textColorHint="@color/laya_muted"
                            app:backgroundTint="@null"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:paddingEnd="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/laya_card"
                android:paddingLeft="26dp"
                android:paddingTop="23dp"
                android:paddingRight="26dp"
                android:paddingBottom="29dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/firstChargeTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:minHeight="36dp"
                        android:gravity="center_vertical"
                        android:text="@string/first_charge_title"
                        android:textColor="@color/laya_text"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                    <com.example.myapplication.InfoTooltip
                        android:id="@+id/chargesHelp" style="@style/InfoTooltipButton"
                        app:helpTitle="@string/tooltip_charges_title"
                        app:helpText="@string/tooltip_charges"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Min. Penalty Period"
                        android:textColor="@color/laya_label"
                        android:textSize="16sp"
                        android:layout_weight="1"
                        android:paddingEnd="8dp"/>
                    <EditText
                        android:id="@+id/inputMinYears"
                        android:layout_width="50dp"
                        android:layout_height="32dp"
                        android:background="@drawable/entertextbox"
                        android:layout_marginVertical="5dp"
                        android:paddingStart="7dp"
                        android:textSize="11sp"
                        android:hint="Years"
                        android:inputType="number"
                        android:textColor="@color/laya_input_text"
                        android:textColorHint="@color/laya_muted"
                        app:backgroundTint="@null"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:paddingEnd="4dp"/>
                    <EditText
                        android:id="@+id/inputMinMonths"
                        android:layout_width="50dp"
                        android:layout_height="32dp"
                        android:background="@drawable/entertextbox"
                        android:layout_marginVertical="5dp"
                        android:paddingStart="7dp"
                        android:textSize="11sp"
                        android:hint="Months"
                        android:inputType="number"
                        android:textColor="@color/laya_input_text"
                        android:layout_marginStart="5dp"
                        android:textColorHint="@color/laya_muted"
                        app:backgroundTint="@null"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:paddingEnd="4dp"/>
                    <EditText
                        android:id="@+id/inputMinDays"
                        android:layout_width="50dp"
                        android:layout_height="32dp"
                        android:background="@drawable/entertextbox"
                        android:layout_marginVertical="5dp"
                        android:paddingStart="7dp"
                        android:textSize="11sp"
                        android:hint="Days"
                        android:inputType="number"
                        android:textColor="@color/laya_input_text"
                        android:layout_marginStart="5dp"
                        android:textColorHint="@color/laya_muted"
                        app:backgroundTint="@null"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:paddingEnd="4dp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Max. Penalty Period"
                        android:textColor="@color/laya_label"
                        android:textSize="16sp"
                        android:layout_weight="1"
                        android:paddingEnd="8dp"/>
                    <EditText
                        android:id="@+id/inputMaxYears"
                        android:layout_width="50dp"
                        android:layout_height="32dp"
                        android:background="@drawable/entertextbox"
                        android:layout_marginVertical="5dp"
                        android:paddingStart="7dp"
                        android:textSize="11sp"
                        android:hint="Years"
                        android:inputType="number"
                        android:textColor="@color/laya_input_text"
                        android:textColorHint="@color/laya_muted"
                        app:backgroundTint="@null"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:paddingEnd="4dp"/>
                    <EditText
                        android:id="@+id/inputMaxMonths"
                        android:layout_width="50dp"
                        android:layout_height="32dp"
                        android:background="@drawable/entertextbox"
                        android:layout_marginVertical="5dp"
                        android:paddingStart="7dp"
                        android:textSize="11sp"
                        android:hint="Months"
                        android:inputType="number"
                        android:textColor="@color/laya_input_text"
                        android:layout_marginStart="5dp"
                        android:textColorHint="@color/laya_muted"
                        app:backgroundTint="@null"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:paddingEnd="4dp"/>
                    <EditText
                        android:id="@+id/inputMaxDays"
                        android:layout_width="50dp"
                        android:layout_height="32dp"
                        android:background="@drawable/entertextbox"
                        android:layout_marginVertical="5dp"
                        android:paddingStart="7dp"
                        android:textSize="11sp"
                        android:hint="Days"
                        android:inputType="number"
                        android:textColor="@color/laya_input_text"
                        android:layout_marginStart="5dp"
                        android:textColorHint="@color/laya_muted"
                        app:backgroundTint="@null"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:paddingEnd="4dp"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/additionalChargesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addChargeButton"
                    style="@style/AppTextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="start"
                    android:text="@string/add_charge"
                    android:textAllCaps="false"
                    android:textColor="@color/laya_primary"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/laya_card"
                android:paddingLeft="26dp"
                android:paddingTop="23dp"
                android:paddingRight="26dp"
                android:paddingBottom="29dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="LEA Arrest Date"
                        android:textColor="@color/laya_label"
                        android:textSize="16sp"
                        android:layout_weight="1"
                        android:paddingEnd="8dp"/>
                    <com.example.myapplication.InfoTooltip
                        android:id="@+id/leaHelp" style="@style/InfoTooltipButton"
                        app:helpTitle="@string/tooltip_lea_title"
                        app:helpText="@string/tooltip_lea"/>
                    <EditText
                        android:id="@+id/inputLEADate"
                        android:layout_width="120dp"
                        android:layout_height="32dp"
                        android:background="@drawable/entertextbox"
                        android:layout_marginVertical="5dp"
                        android:paddingStart="7dp"
                        android:textSize="11sp"
                        android:hint="mm/dd/yy"
                        android:focusable="false"
                        android:clickable="true"
                        android:inputType="none"
                        android:textColor="@color/laya_input_text"
                        android:textColorHint="@color/laya_muted"
                        app:backgroundTint="@null"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:paddingEnd="4dp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <TextView
                        android:id="@+id/commitmentDateLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Jail Commitment Date"
                        android:textColor="@color/laya_label"
                        android:textSize="16sp"
                        android:layout_weight="1"
                        android:paddingEnd="8dp"/>
                    <EditText
                        android:id="@+id/inputCommitmentDate"
                        android:layout_width="120dp"
                        android:layout_height="32dp"
                        android:background="@drawable/entertextbox"
                        android:layout_marginVertical="5dp"
                        android:paddingStart="7dp"
                        android:textSize="11sp"
                        android:hint="mm/dd/yy"
                        android:focusable="false"
                        android:clickable="true"
                        android:inputType="none"
                        android:textColor="@color/laya_input_text"
                        android:textColorHint="@color/laya_muted"
                        app:backgroundTint="@null"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:paddingEnd="4dp"/>
                </LinearLayout>
                <include layout="@layout/view_prison_transfer_input" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:background="@drawable/entertextbox"
                    android:layout_marginVertical="4dp"
                    android:paddingHorizontal="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Not Committed To Jail"
                        android:textColor="@color/laya_text"
                        android:textSize="16sp"
                        android:layout_weight="1"
                        android:paddingEnd="8dp"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/committedSwitch"
                        android:checked="false"
                        android:layout_height="48dp"
                        android:layout_width="60dp"
                        android:layout_marginVertical="3dp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:background="@drawable/entertextbox"
                    android:layout_marginVertical="4dp"
                    android:paddingHorizontal="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Disqualified for CPI"
                        android:textColor="@color/laya_text"
                        android:textSize="16sp"
                        android:layout_weight="1"
                        android:paddingEnd="8dp"/>
                    <com.example.myapplication.InfoTooltip
                        android:id="@+id/cpiHelp" style="@style/InfoTooltipButton"
                        app:helpTitle="@string/tooltip_cpi_title"
                        app:helpText="@string/tooltip_cpi"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/disqualifiedCPISwitch"
                        android:checked="false"
                        android:layout_height="48dp"
                        android:layout_width="60dp"
                        android:layout_marginVertical="3dp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:background="@drawable/entertextbox"
                    android:layout_marginVertical="4dp"
                    android:paddingHorizontal="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Disqualified for Time Allowances"
                        android:textColor="@color/laya_text"
                        android:textSize="16sp"
                        android:layout_weight="1"
                        android:paddingEnd="8dp"/>
                    <com.example.myapplication.InfoTooltip
                        android:id="@+id/timeAllowancesHelp" style="@style/InfoTooltipButton"
                        app:helpTitle="@string/tooltip_ta_title"
                        app:helpText="@string/tooltip_ta"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/disqualifiedTASwitch"
                        android:checked="false"
                        android:layout_height="48dp"
                        android:layout_width="60dp"
                        android:layout_marginVertical="3dp"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/triggerDetailsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/laya_card"
                android:paddingLeft="26dp"
                android:paddingTop="23dp"
                android:paddingRight="26dp"
                android:paddingBottom="29dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="STAL (Loyalty Credit)"
                        android:textColor="@color/laya_label"
                        android:textSize="16sp"
                        android:layout_weight="1"
                        android:paddingEnd="8dp"/>
                    <Spinner
                        android:id="@+id/inputSTAL"
                        android:layout_width="120dp"
                        android:layout_height="32dp"
                        android:layout_marginVertical="5dp"
                        android:minHeight="32dp"
                        android:paddingStart="7dp"
                        android:paddingEnd="28dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:dropDownWidth="wrap_content"
                        android:spinnerMode="dropdown"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Deductions"
                        android:textColor="@color/laya_label"
                        android:textSize="16sp"
                        android:layout_weight="1"
                        android:paddingEnd="8dp"/>
                    <com.example.myapplication.InfoTooltip
                        android:id="@+id/manualDeductionHelp" style="@style/InfoTooltipButton"
                        app:helpTitle="@string/tooltip_deductions_title"
                        app:helpText="@string/tooltip_deductions"/>
                    <EditText
                        android:id="@+id/inputDeductionRaw"
                        android:layout_width="120dp"
                        android:layout_height="32dp"
                        android:background="@drawable/entertextbox"
                        android:layout_marginVertical="5dp"
                        android:paddingStart="7dp"
                        android:textSize="11sp"
                        android:hint="Days"
                        android:inputType="number"
                        android:textColor="@color/laya_input_text"
                        android:textColorHint="@color/laya_muted"
                        app:backgroundTint="@null"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:paddingEnd="4dp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Time Gap on Bail/ATI"
                        android:textColor="@color/laya_label"
                        android:textSize="16sp"
                        android:layout_weight="1"
                        android:paddingEnd="8dp"/>
                    <EditText
                        android:id="@+id/inputTimeGap"
                        android:layout_width="120dp"
                        android:layout_height="32dp"
                        android:background="@drawable/entertextbox"
                        android:layout_marginVertical="5dp"
                        android:paddingStart="7dp"
                        android:textSize="11sp"
                        android:hint="Days"
                        android:inputType="number"
                        android:textColor="@color/laya_input_text"
                        android:textColorHint="@color/laya_muted"
                        app:backgroundTint="@null"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:paddingEnd="4dp"/>
                </LinearLayout>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/saveEntryButton"
                android:layout_marginTop="10dp"
                android:layout_width="282dp"
                android:layout_height="80dp"
                android:background="@drawable/button_background"
                android:textColor="@color/laya_white"
                android:textStyle="bold"
                android:textSize="20sp"
                android:backgroundTint="@null"
                android:text="@string/calculate_entry"
                app:backgroundTint="@null"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:minHeight="80dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingLeft="28dp"
                android:paddingTop="22dp"
                android:paddingRight="28dp"
                android:paddingBottom="30dp"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
