<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".newEntryActivity"
    android:background="@drawable/login_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:layout_marginTop="20dp"
            android:layout_marginStart="20dp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:background="@drawable/login_title"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"/>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/homeButtonNE"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:background="@null"
            android:onClick="goHomeNE"
            android:src="@drawable/outline_bungalow_24" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:text="ADD ENTRY"
        android:textSize="35sp"
        />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/profileImage"
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Upload profile image"
                android:scaleType="centerCrop"
                android:src="@drawable/outline_account_box_24"
                app:strokeColor="#999999"
                app:strokeWidth="3dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start"
                android:paddingStart="15dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="First Name"
                    android:textColor="@color/black"
                    android:textSize="20sp"/>
                <EditText
                    android:id="@+id/inputFirstName"
                    android:layout_width="120dp"
                    android:layout_height="32dp"
                    android:background="@drawable/entertextbox"
                    android:layout_marginVertical="5dp"
                    android:paddingStart="7dp"
                    android:textSize="11sp"
                    android:hint="e.g. John"
                    android:textColor="@color/black"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last Name"
                    android:textColor="@color/black"
                    android:textSize="20sp"/>
                <EditText
                    android:id="@+id/inputLastName"
                    android:layout_width="120dp"
                    android:layout_height="32dp"
                    android:background="@drawable/entertextbox"
                    android:layout_marginVertical="5dp"
                    android:paddingStart="7dp"
                    android:textSize="11sp"
                    android:hint="e.g. Doe"
                    android:textColor="@color/black"/>


            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Incarceration Date"
                android:textColor="@color/black"
                android:textSize="20sp"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <EditText
                android:id="@+id/inputDate"
                android:layout_width="120dp"
                android:layout_height="32dp"
                android:background="@drawable/entertextbox"
                android:layout_marginVertical="5dp"
                android:paddingStart="7dp"
                android:textSize="11sp"
                android:hint="mm/dd/yy"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none"
                android:textColor="@color/black"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sentence Length"
                android:textColor="@color/black"
                android:textSize="20sp"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <EditText
                android:id="@+id/inputYears"
                android:layout_width="50dp"
                android:layout_height="32dp"
                android:background="@drawable/entertextbox"
                android:layout_marginVertical="5dp"
                android:paddingStart="7dp"
                android:textSize="11sp"
                android:hint="Years"
                android:inputType="number"
                android:textColor="@color/black"/>

            <EditText
                android:id="@+id/inputMonths"
                android:layout_width="50dp"
                android:layout_height="32dp"
                android:background="@drawable/entertextbox"
                android:layout_marginVertical="5dp"
                android:paddingStart="7dp"
                android:textSize="11sp"
                android:hint="Months"
                android:inputType="number"
                android:textColor="@color/black"
                android:layout_marginStart="5dp"/>

            <EditText
                android:id="@+id/inputDays"
                android:layout_width="50dp"
                android:layout_height="32dp"
                android:background="@drawable/entertextbox"
                android:layout_marginVertical="5dp"
                android:paddingStart="7dp"
                android:textSize="11sp"
                android:hint="Days"
                android:inputType="number"
                android:textColor="@color/black"
                android:layout_marginStart="5dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crime Charged"
                android:textColor="@color/black"
                android:textSize="20sp"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <EditText
                android:id="@+id/inputCrime"
                android:layout_width="120dp"
                android:layout_height="32dp"
                android:background="@drawable/entertextbox"
                android:layout_marginVertical="5dp"
                android:paddingStart="7dp"
                android:textSize="11sp"
                android:hint="e.g. Simple Theft"
                android:inputType="text"
                android:textColor="@color/black"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GCTA"
                android:textColor="@color/black"
                android:textSize="20sp"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <EditText
                android:id="@+id/inputGCTA"
                android:layout_width="120dp"
                android:layout_height="32dp"
                android:background="@drawable/entertextbox"
                android:layout_marginVertical="5dp"
                android:paddingStart="7dp"
                android:textSize="11sp"
                android:hint="Hours"
                android:inputType="number"
                android:textColor="@color/black"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TASTM"
                android:textColor="@color/black"
                android:textSize="20sp"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <EditText
                android:id="@+id/inputTASTM"
                android:layout_width="120dp"
                android:layout_height="32dp"
                android:background="@drawable/entertextbox"
                android:layout_marginVertical="5dp"
                android:paddingStart="7dp"
                android:textSize="11sp"
                android:hint="Hours"
                android:inputType="number"
                android:textColor="@color/black"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STAL"
                android:textColor="@color/black"
                android:textSize="20sp"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <!-- Change this with a date picker!!! -->
            <EditText
                android:id="@+id/inputSTAL"
                android:layout_width="120dp"
                android:layout_height="32dp"
                android:background="@drawable/entertextbox"
                android:layout_marginVertical="5dp"
                android:paddingStart="7dp"
                android:textSize="11sp"
                android:hint="Hours"
                android:inputType="number"
                android:textColor="@color/black"/>

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/saveEntryButton"
            android:layout_marginTop="10dp"
            android:layout_width="250dp"
            android:layout_height="50dp"
            android:background="@drawable/credentials_background"
            android:textStyle="bold"
            android:textSize="24sp"
            android:text="SAVE ENTRY"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>