<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:orientation="vertical" android:padding="14dp" android:background="@drawable/deduction_card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/deductionMonthName" style="@style/DeductionLabel" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/laya_text"/>
            <TextView android:id="@+id/deductionMonthTier" style="@style/DeductionLabel" android:layout_marginTop="3dp"/>
            <TextView android:id="@+id/deductionMonthEarned" style="@style/DeductionLabel" android:layout_marginTop="3dp" android:textSize="11sp"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/deductionRemoveMonth" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" app:srcCompat="@drawable/ic_deduction_trash"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="10dp" android:background="@color/laya_divider"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="5dp" android:padding="10dp" android:orientation="vertical" android:background="@drawable/deduction_detail">
            <androidx.appcompat.widget.AppCompatCheckBox android:id="@+id/deductionGcta" android:layout_width="match_parent" android:layout_height="48dp" android:layoutDirection="rtl" android:text="GCTA" android:textSize="12sp" android:textColor="@color/laya_label" app:buttonTint="@color/laya_primary" android:saveEnabled="false"/>
            <TextView android:id="@+id/deductionGctaDays" style="@style/DeductionValue"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="5dp" android:padding="10dp" android:orientation="vertical" android:background="@drawable/deduction_detail">
            <androidx.appcompat.widget.AppCompatCheckBox android:id="@+id/deductionTastm" android:layout_width="match_parent" android:layout_height="48dp" android:layoutDirection="rtl" android:text="TASTM" android:textSize="12sp" android:textColor="@color/laya_label" app:buttonTint="@color/laya_primary" android:saveEnabled="false"/>
            <TextView android:id="@+id/deductionTastmDays" style="@style/DeductionValue"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:padding="10dp" android:orientation="vertical" android:background="@drawable/deduction_detail">
        <TextView style="@style/DeductionLabel" android:text="@string/deduction_total"/>
        <TextView android:id="@+id/deductionMonthTotal" style="@style/DeductionValue" android:layout_marginTop="4dp"/>
    </LinearLayout>
</LinearLayout>
