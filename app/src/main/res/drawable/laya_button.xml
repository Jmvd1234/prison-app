<?xml version="1.0" encoding="utf-8"?>
<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingMode="stack">
    <!-- Web shadow: 0 4px 15px; radius 9px. No native elevation overlay. -->
    <item>
        <nine-patch
            android:src="@drawable/laya_button_shadow_mask"
            android:tint="@color/laya_button_shadow"/>
    </item>
    <item
        android:left="16dp"
        android:top="12dp"
        android:right="16dp"
        android:bottom="20dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/laya_primary"/>
            <corners android:radius="9dp"/>
        </shape>
    </item>
</layer-list>
