<?xml version='1.0' encoding='utf-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/laya_background">
    <LinearLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginTop="20dp" android:background="@drawable/login_title" android:paddingHorizontal="10dp" android:paddingVertical="5dp" android:text="@string/app_name" android:textColor="@color/laya_text" android:textStyle="bold" />
        <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
        <ImageButton android:id="@+id/homeButton" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginTop="20dp" android:layout_marginEnd="20dp" android:background="@null" android:onClick="goHome" android:src="@drawable/outline_bungalow_24" app:tint="@color/laya_primary" android:elevation="0dp" android:stateListAnimator="@null" />
    </LinearLayout>
    <androidx.constraintlayout.widget.Guideline android:id="@+id/freeDashboardGuide" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.4" />
    <androidx.core.widget.NestedScrollView android:layout_width="0dp" android:layout_height="0dp" android:paddingHorizontal="12dp" android:paddingBottom="12dp" app:layout_constraintTop_toBottomOf="@id/topBar" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/freeDashboardGuide">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="10dp" android:gravity="center" android:orientation="vertical" android:id="@+id/sortControls" android:paddingHorizontal="0dp">
                <Spinner android:id="@+id/sortDropdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="5dp" />
                <Spinner android:id="@+id/orderDropdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="5dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/transferControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/exportProfiles" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp" android:text="@string/export_profiles" android:textAllCaps="false" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/importProfiles" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/import_profiles" android:textAllCaps="false" />
                </LinearLayout>
                <LinearLayout android:id="@+id/exportSelectionControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/export_privacy" android:textSize="12sp" android:textColor="@color/laya_muted" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton android:id="@+id/selectAllProfiles" style="?attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/select_all_profiles" android:textAllCaps="false" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/cancelExport" style="?attr/borderlessButtonStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@android:string/cancel" android:textAllCaps="false" />
                    </LinearLayout>
                </LinearLayout>
                <include layout="@layout/view_free_slots" />
                <TextView android:id="@+id/transferProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/transfer_working" android:textColor="@color/laya_label" android:paddingVertical="6dp" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:id="@+id/recyclerLayout" android:layout_width="0dp" android:layout_height="0dp" android:gravity="center" android:orientation="vertical" app:layout_constraintBottom_toTopOf="@id/freeBannerPrimary" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="@id/freeDashboardGuide" android:layout_marginTop="10dp" android:layout_marginHorizontal="8dp" app:layout_constraintTop_toBottomOf="@id/topBar">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/profileRecyclerView" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingBottom="16dp" android:clipToPadding="false" />
    </LinearLayout>
    <FrameLayout android:id="@+id/freeBannerPrimary" android:layout_width="0dp" android:layout_height="wrap_content" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="@id/freeDashboardGuide" app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>